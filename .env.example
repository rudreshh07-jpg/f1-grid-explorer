# Local SQLite database path (optional)
# F1_DB_PATH=./server/f1-grid.sqlite

# Set a strong password before deployment. Never commit a real .env file.
# In production also set APP_ORIGIN to the exact frontend origin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-12-character-password

# Exact frontend origin allowed to call the API (recommended for production)
# APP_ORIGIN=https://your-frontend.example.com

# Optional ports
PORT=4000
# VITE_API_URL=http://localhost:4000/api
